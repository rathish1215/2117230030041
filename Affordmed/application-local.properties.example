# ============================================================
#  LOCAL DATABASE CONFIGURATION (TEMPLATE)
# ============================================================
#
#  SETUP STEPS:
#
#  1. Copy this file to the same directory and rename it:
#     application-local.properties.example  -->  application-local.properties
#
#  2. Replace the placeholder values below with your actual
#     MySQL database credentials.
#
#  3. Make sure MySQL is running on your machine and the
#     database exists. You can create it using:
#     CREATE DATABASE affordmed;
#
#  4. Run the application:
#     mvn spring-boot:run
#
#  WARNING: Do NOT commit application-local.properties
#           It is already added to .gitignore
#
# ============================================================

spring.datasource.url=jdbc:mysql://localhost:3306/your_database_name
spring.datasource.username=your_username
spring.datasource.password=your_password
